{
  "name": "gameslane-ios",
  "version": "1.0.0",
  "description": "GamesLane iPhone app (Capacitor)",
  "scripts": {
    "sync": "cap sync ios",
    "open": "cap open ios",
    "ios": "cap sync ios && cap open ios",
    "simulator": "cap sync ios && cap run ios",
